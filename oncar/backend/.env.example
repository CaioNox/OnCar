# Perfil ativo do Spring (dev = H2 em memoria, prod = PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Conexao PostgreSQL (usado apenas no perfil prod)
ONCAR_DB_URL=jdbc:postgresql://localhost:5432/oncar
ONCAR_DB_USER=oncar
ONCAR_DB_PASSWORD=troque-esta-senha

# Primeiro proprietario do perfil prod: criado so enquanto a base nao tem nenhum usuario.
# A senha precisa de 8 caracteres ou mais, com letra e numero.
ONCAR_ADMIN_NOME=Proprietario
ONCAR_ADMIN_EMAIL=proprietario@suaoficina.com.br
ONCAR_ADMIN_SENHA=troque123

# Porta publicada pelo docker-compose.yml desta pasta
ONCAR_PORTA_API=8080
