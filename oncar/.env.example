# Variaveis do docker-compose.yml (copie para .env, que nao vai para o Git)

# Senha do PostgreSQL do container (obrigatoria)
ONCAR_DB_USER=oncar
ONCAR_DB_PASSWORD=troque-esta-senha

# Primeiro proprietario: criado so enquanto a base nao tem nenhum usuario.
# A senha precisa de 8 caracteres ou mais, com letra e numero.
ONCAR_ADMIN_NOME=Proprietario
ONCAR_ADMIN_EMAIL=proprietario@suaoficina.com.br
ONCAR_ADMIN_SENHA=troque123

# Portas publicadas no computador
ONCAR_PORTA_API=8080
ONCAR_PORTA_WEB=3000
